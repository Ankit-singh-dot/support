{
  "name": "support-desk-backend",
  "version": "1.0.0",
  "description": "Express and Prisma REST API for Freshdesk-inspired Support Desk System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:start": "node scripts/start-db.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed.js",
    "db:clear": "node scripts/clear-db.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@clerk/express": "^1.3.39",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "16.14.0-beta.17",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}
