generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EntryType {
  PUBLIC_REPLY
  INTERNAL_NOTE
}

model User {
  id              String        @id @default(uuid())
  clerkId         String        @unique
  email           String        @unique
  name            String
  role            Role          @default(CUSTOMER)
  password        String?
  company         String?
  phone           String?
  onboarded       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customerTickets Ticket[]      @relation("CustomerTickets")
  assignedTickets Ticket[]      @relation("AssignedTickets")
  entries         TicketEntry[]
  activities      ActivityLog[]

  @@index([role])
  @@index([email])
}

model Ticket {
  id          String         @id @default(uuid())
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  customerId  String
  customer    User           @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?          @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  entries     TicketEntry[]
  activities  ActivityLog[]

  @@index([customerId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([updatedAt])
}

model TicketEntry {
  id        String    @id @default(uuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  type      EntryType
  createdAt DateTime  @default(now())

  @@index([ticketId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
